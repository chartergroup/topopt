  "hook": {
   "spec": "examples/hook/hook.yaml (F1-3 runs)",
   "voxel_mm": 2.4
  },
  "bracket": {
   "spec": "examples/interfaces/bracket.yaml (F1-3 runs)",
   "voxel_mm": 1.0
  },
  "ladle": {
