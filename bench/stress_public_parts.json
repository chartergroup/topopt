  "phone_stand": {
   "spec": "bench/stress_public_parts_specs/phone_stand_R.yaml and phone_stand_MS_spec.yaml",
   "voxel_mm": 2.45
  },
  "note": "`*_R.yaml` has no stress limit (type R). `*_MS_spec.yaml` has the stress limits (the relaxed peak of the R run at its last pass, 4 digits); type CS uses 0.9 x these limits. The part builder does not copy `settings.objective`: the YAML that it writes got `objective: mass` by hand for the types MS and MF."
 },
 "preregistration": "The rules, the definitions and the four tests were written before the first ratio was computed (2026-10-25, 09:25Z; three dated amendments before the runs they cover). The file is not in the repository.",
 "tests": {
  "H1": {
   "rule": "one band: max / min of p2_over_voxel over the cells <= 1.5",
   "result": false,
   "max_over_min": 3.764
  },
  "H2": {
   "rule": "the finding is general: the median of p2_over_voxel >= 1.5",
   "result": false,
   "median": 1.011,
   "q25": 0.916,
   "q75": 1.143
  },
  "H3": {
   "rule": "resolution: Spearman rho of p2_over_voxel with member_p10_voxels <= -0.6, and the ratio falls with the finer voxel in every voxel-size pair",
   "result": false,
   "spearman_rho_p10": 0.065,
   "pairs": 5,
   "pairs_that_fall": 4,
   "note": "the 4 pairs that fall are the hook; the bracket pair rises; the bracket pair with a mass objective could not be made (verify could not mesh it). The pairs are not cells of this file"
  },
  "H4": {
   "rule": "hot spot at a region: in the 3 cells with the largest ratio, more than half of the P2 volume at or above its p99.9 lies within 2 mm of a fixed or load region",
   "result": true,
   "top3_near_share": [
    0.848,
    0.753,
    0.892
   ],
   "note": "all three cells are the hook, load case pull_off; 44 to 45 % of the hook volume is within 2 mm of a region, and the gap stays at 1.6 to 2.0 times when those points are left out"
  }
 },
 "limits": [
  "one host; run-to-run noise: the median difference between a run and its repeat is 8.5 % of the ratio (12 pairs)",
  "5 parts; the cells of one part are not independent. The hook is the only part with ratios above 1.5 (besides one phone stand cell)",
  "P2 is not a converged reference: a second, finer verify mesh on 5 cases changed the P2 p99.9 by -5.4 % to +2.3 %; the P2 peak moves more",
  "cells with fewer than 5000 voxels in scope have a voxel p99.9 that rests on the top 1 to 4 voxels (`p99_9_equals_peak`)",
  "no part has a thin-wall shell, a bore or a fillet; no pressure load, moment, spring or joint"
 ],
